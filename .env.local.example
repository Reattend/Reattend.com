# Auth
NEXTAUTH_SECRET=                  # openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000

# Database
DATABASE_URL=./data/reattend.db

# Email (Resend) — https://resend.com
RESEND_API_KEY=

# AI — Claude primary (Ask/chat), Groq fallback (pipeline agents: triage, linking, summaries)
# Embeddings run locally via fastembed.
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# AssemblyAI — meeting transcription (Nano model, async) — https://assemblyai.com
ASSEMBLYAI_API_KEY=

# App base URL
APP_URL=http://localhost:3000

# Google OAuth — https://console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth — https://portal.azure.com
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
TENANT_ID=

# Slack integration — https://api.slack.com/apps
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Paddle billing — https://vendors.paddle.com
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
PADDLE_API_KEY=
PADDLE_SELLER_ID=
PADDLE_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_PRICE_ID=
NEXT_PUBLIC_PADDLE_PRO_ANNUAL_PRICE_ID=
NEXT_PUBLIC_PADDLE_TEAMS_PRICE_ID=
NEXT_PUBLIC_PADDLE_TEAMS_ANNUAL_PRICE_ID=

# Slack game app (optional)
SLACK_GAME_CLIENT_ID=
SLACK_GAME_CLIENT_SECRET=
SLACK_GAME_SIGNING_SECRET=

# Slack standup app (optional)
SLACK_STANDUP_CLIENT_ID=
SLACK_STANDUP_CLIENT_SECRET=
SLACK_STANDUP_SIGNING_SECRET=

# Cron secret — used to authorize scheduled job endpoints
CRON_SECRET=

# Microsoft Teams bot (optional)
TEAMS_BOT_APP_ID=
TEAMS_BOT_APP_PASSWORD=
